# Copy to .env and fill in values before building.
# Loaded at build time via --dart-define-from-file=.env
# (tool/build_apk.sh passes this automatically when .env exists).

# Base URL of the CyberNeurova API.
# Has a compiled-in default of the production URL, so this is an override.
API_BASE_URL=https://cyberneurova.ai/api/mobile/v1

# Google sign-in.
#
# GOOGLE_SERVER_CLIENT_ID is the WEB client passed to GoogleSignIn as
# `serverClientId`, and it is also the audience the server verifies on
# /auth/google.
#
# IT MUST BE THE WEB CLIENT FROM THE SAME GOOGLE CLOUD PROJECT AS THE ANDROID
# OAUTH CLIENTS — project 440622763104, which holds both `cyberneurova`
# (production, Play app-signing SHA-1) and `cyberneurova2` (development, debug
# SHA-1). Google rejects a cross-project pair with DEVELOPER_ERROR 28444, which
# reads exactly like an unregistered fingerprint and sends you to the wrong
# place. The compiled-in default belongs to a DIFFERENT project, so a build
# made without this file has a Google button that cannot work — that is the
# whole reason this line is shouting.
#
# GOOGLE_INSTALLED_CLIENT_ID is an OAuth client of type "Desktop app", used by
# the system-browser PKCE fallback for phones where Play services refuses the
# app (the `direct` flavour's targetSdk 28, or a de-Googled ROM). It has NO
# default: leave it unset and that fallback never engages, so a Play-services
# failure has nowhere to go. See docs/AUTH_DIRECT_FLAVOUR.md.
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_INSTALLED_CLIENT_ID=

# App environment: development | staging | production
APP_ENV=development
